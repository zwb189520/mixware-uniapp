{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": [
    "api/**/*.ts",
    "stores/**/*.ts",
    "composables/**/*.ts",
    "utils/permission.ts",
    "utils/streamRequest.ts",
    "utils/bluetooth.ts",
    "constants/index.ts",
    "types/**/*.d.ts",
    "main.ts",
    "App.vue",
    "pages/**/*.vue",
    "pages/**/*.ts",
    "pagesMember/**/*.vue",
    "pagesMember/**/*.ts",
    "components/**/*.vue",
    "components/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "unpackage",
    "stores/modules/language.ts",
    "components/**"
  ]
}
