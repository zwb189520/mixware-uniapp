  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "uni-app",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#FF5A00",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/explore/explore/explore",
        "iconPath": "static/tabs/tab-explore.png",
        "selectedIconPath": "static/tabs/tab-explore-active.png",
        "text": "Explore"
      },
      {
        "pagePath": "pages/create/create/create",
        "iconPath": "static/tabs/tab-create.png",
        "selectedIconPath": "static/tabs/tab-create-active.png",
        "text": "Create"
      },
      {
        "pagePath": "pages/profile/profile",
        "iconPath": "static/tabs/tab-profile.png",
        "selectedIconPath": "static/tabs/tab-profile-active.png",
        "text": "Profile"
      }
    ]
  },
