  "preloadRule": {
    "pages/profile/profile": {
      "network": "all",
      "packages": [
        "pagesMember/auth",
        "pagesMember/printer",
        "pagesMember/message",
        "pagesMember/user"
      ]
    },
    "pages/create/create/create": {
